# ---------------------------------------------------------------- access gate
# Used until Supabase auth is switched on. The cohort roster is the allowlist;
# the code proves the person was actually given the link.
COHORT_ACCESS_CODE=
# Secret used to sign the session cookie. Any long random string.
AUTH_SECRET=

# "admin"  — only ADMIN_EMAILS can sign in (default; use while setting the site up)
# "cohort" — anyone on the roster with the access code can sign in, landing page goes public
ACCESS_MODE=admin

# --------------------------------------------------------------- Supabase
# Leave blank to run on the access gate above with in-memory data.
# Fill in to switch on real accounts, magic-link sign-in and persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used only by scripts/admin tasks, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
